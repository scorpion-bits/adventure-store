{
  "name": "loja-do-aventureiro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:site": "vite build --mode site",
    "publish:site": "node scripts/publish-site.mjs",
    "pack:icons": "node scripts/pack-icons.mjs",
    "validate": "node scripts/validate-data.mjs",
    "test": "npm run validate && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test --config tests/playwright.config.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "vite": "^8.3.3"
  }
}
